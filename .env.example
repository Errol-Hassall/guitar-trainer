# SQLite database file. Parent directories are created automatically.
DATABASE_PATH=data/guitar-trainer.db

# Port the application listens on inside the container/process.
PORT=3000

# Interface the application binds to.
HOST=0.0.0.0

# Host port published by docker-compose.yml.
APP_PORT=3000

# UID/GID that owns the data volume and runs the app in Docker.
PUID=1000
PGID=1000
